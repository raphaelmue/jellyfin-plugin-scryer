<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Jellyfin.Plugin.Scryer</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.Scryer</RootNamespace>
    <Product>Scryer</Product>
    <Version>0.1.25.0</Version>
  </PropertyGroup>

  <!-- A higher revision lets a server upgrade replace the older runtime's assembly. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Version>$([System.Version]::Parse('$(Version)').ToString(3)).1</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <InternalsVisibleTo Include="Scryer.Plugin.SelfTest" />
  </ItemGroup>

  <!-- Each server line needs its own assembly; never ship Jellyfin's assemblies in the plugin ZIP. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Web\scryer-loader.js" />
    <EmbeddedResource Include="Web\scryer-strings.js" />
    <EmbeddedResource Include="Web\scryer-core.js" />
    <EmbeddedResource Include="Web\scryer-styles.js" />
    <EmbeddedResource Include="Web\scryer-discovery.js" />
    <EmbeddedResource Include="Web\scryer-calendar.js" />
    <EmbeddedResource Include="Web\scryer-requests.js" />
    <EmbeddedResource Include="Web\scryer-downloads.js" />
    <EmbeddedResource Include="Web\scryer-logo.svg" />
    <EmbeddedResource Include="Web\jellyfin-logo.svg" />
    <EmbeddedResource Include="artwork\scryer-plugin.png" />
  </ItemGroup>

</Project>
